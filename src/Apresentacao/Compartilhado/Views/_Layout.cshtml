@{
    string controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    @* Aplica o tema salvo antes de renderizar a página (o padrão é o tema claro) *@
    <script>
        (() => {
            let tema = null;

            try { tema = localStorage.getItem("tema"); } catch { }

            document.documentElement.setAttribute("data-bs-theme", tema === "dark" ? "dark" : "light");
        })();
    </script>

    @* Importação do CSS do Bootstrap *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    @* Importação dos ícones do Bootstrap *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        [data-bs-theme="light"] {
            --ea-fundo-pagina: #f3f5fa;
            --ea-fundo-card: #ffffff;
            --ea-sombra-card: 0 1px 2px rgba(16, 24, 40, .06), 0 1px 3px rgba(16, 24, 40, .08);
            --ea-sombra-card-hover: 0 8px 24px rgba(16, 24, 40, .12);
        }

        [data-bs-theme="dark"] {
            --ea-fundo-pagina: #121418;
            --ea-fundo-card: #1c1f24;
            --ea-sombra-card: 0 1px 2px rgba(0, 0, 0, .5);
            --ea-sombra-card-hover: 0 8px 24px rgba(0, 0, 0, .6);
        }

        body {
            background-color: var(--ea-fundo-pagina);
        }

        .navbar,
        .card {
            --bs-card-bg: var(--ea-fundo-card);
            background-color: var(--ea-fundo-card);
        }

        /* Cards das listagens */
        .card-item {
            --ea-acento: var(--bs-primary);
            border: 1px solid var(--bs-border-color-translucent);
            border-radius: 1rem;
            box-shadow: var(--ea-sombra-card);
            overflow: hidden;
            transition: transform .15s ease, box-shadow .15s ease;
        }

        .card-item::before {
            content: "";
            display: block;
            height: 4px;
            background-color: var(--ea-acento);
        }

        .card-item:hover {
            transform: translateY(-2px);
            box-shadow: var(--ea-sombra-card-hover);
        }

        .acento-success { --ea-acento: var(--bs-success); }
        .acento-info { --ea-acento: var(--bs-info); }
        .acento-warning { --ea-acento: var(--bs-warning); }
        .acento-danger { --ea-acento: var(--bs-danger); }
        .acento-secondary { --ea-acento: var(--bs-secondary); }

        .card-icone {
            display: flex;
            flex-shrink: 0;
            align-items: center;
            justify-content: center;
            width: 2.75rem;
            height: 2.75rem;
            border-radius: .75rem;
            font-size: 1.25rem;
            font-weight: 600;
        }

        .card-data {
            flex-direction: column;
            line-height: 1;
        }

        .card-data .dia {
            font-size: 1.1rem;
            font-weight: 700;
        }

        .card-data .mes {
            font-size: .7rem;
            text-transform: uppercase;
        }

        .card-id {
            font-family: var(--bs-font-monospace);
            font-weight: 500;
            color: var(--bs-secondary-color);
            background-color: var(--bs-tertiary-bg);
        }

        .card-item dt {
            font-weight: 500;
            color: var(--bs-secondary-color);
        }

        .card-item dt .bi {
            margin-right: .35rem;
        }

        .card-acoes {
            border-top: 1px solid var(--bs-border-color-translucent);
        }

        .progress-fino {
            height: .4rem;
        }

        /* Cards da página inicial */
        .card-modulo {
            border-radius: 1rem;
            box-shadow: var(--ea-sombra-card);
            transition: transform .15s ease, box-shadow .15s ease;
        }

        .card-modulo:hover {
            transform: translateY(-3px);
            box-shadow: var(--ea-sombra-card-hover);
        }

        .card-modulo .card-icone {
            width: 3.5rem;
            height: 3.5rem;
            font-size: 1.6rem;
            border-radius: 1rem;
        }
    </style>

    <title>@ViewBag.Titulo - e-Agenda</title>
</head>
<body>
    @* Barra de Navegação *@
    <nav class="navbar navbar-expand-lg border-bottom sticky-top">
        <div class="container">
            <a class="navbar-brand fw-semibold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-calendar-check text-primary"></i> e-Agenda
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-expanded="false" aria-label="Alternar navegação">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <div class="navbar-nav ms-auto align-items-lg-center">
                    <a class="nav-link @(controllerAtual == "Home" ? "active fw-semibold" : "")" asp-controller="Home" asp-action="Index">Início</a>
                    <a class="nav-link @(controllerAtual == "Contato" ? "active fw-semibold" : "")" asp-controller="Contato" asp-action="Listar">Contatos</a>
                    <a class="nav-link @(controllerAtual == "Compromisso" ? "active fw-semibold" : "")" asp-controller="Compromisso" asp-action="Listar">Compromissos</a>
                    <a class="nav-link @(controllerAtual == "Categoria" ? "active fw-semibold" : "")" asp-controller="Categoria" asp-action="Listar">Categorias</a>
                    <a class="nav-link @(controllerAtual == "Despesa" ? "active fw-semibold" : "")" asp-controller="Despesa" asp-action="Listar">Despesas</a>
                    <a class="nav-link @(controllerAtual == "Tarefa" ? "active fw-semibold" : "")" asp-controller="Tarefa" asp-action="Listar">Tarefas</a>

                    <div class="d-flex align-items-center gap-2 ms-lg-3 mt-2 mt-lg-0 text-body-secondary">
                        <i class="bi bi-sun"></i>
                        <div class="form-check form-switch mb-0">
                            <input id="alternarTema" class="form-check-input" type="checkbox" role="switch" title="Modo escuro" aria-label="Modo escuro">
                        </div>
                        <i class="bi bi-moon-stars"></i>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    @* Cabeçalho da Página *@
    <header class="container py-4">
        <h2 class="fw-semibold mb-0">@ViewBag.Titulo</h2>
    </header>

    @* Conteúdo da Página *@
    <main class="container pb-5">
        @RenderBody()
    </main>

    @* Importação do JavaScript do Bootstrap *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    @* Alternância entre tema claro e escuro *@
    <script>
        (() => {
            const interruptor = document.getElementById("alternarTema");

            interruptor.checked = document.documentElement.getAttribute("data-bs-theme") === "dark";

            interruptor.addEventListener("change", () => {
                const novoTema = interruptor.checked ? "dark" : "light";

                document.documentElement.setAttribute("data-bs-theme", novoTema);

                try { localStorage.setItem("tema", novoTema); } catch { }
            });
        })();
    </script>
</body>
</html>
