@using eAgenda.Dominio.Modulos.Compromissos
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Compromissos";
}

@model List<CompromissoDto>;

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>

@if (!string.IsNullOrWhiteSpace(TempData["MensagemErro"]?.ToString()))
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @TempData["MensagemErro"]!.ToString()
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhum compromisso cadastrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2">
        @foreach (CompromissoDto c in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div class="d-flex flex-column gap-1">
                                <div class="my-1">
                                    <span class="badge bg-secondary rounded-pill small">@c.Tipo</span>
                                </div>
                                <h5 class="card-title mb-0">@c.Assunto</h5>
                            </div>

                            <span class="badge text-bg-primary rounded-pill">@c.Id.ToString("N")[..8]</span>
                        </div>

                        <dl class="row g-2 mb-4">
                            <dt class="col-4 text-secondary fw-semibold">Data</dt>
                            <dd class="col-8 mb-0">@c.DataOcorrencia.ToShortDateString()</dd>

                            <dt class="col-4 text-secondary fw-semibold">Horário</dt>
                            <dd class="col-8 mb-0">@c.HoraInicio.ToString("HH:mm") às @c.HoraTermino.ToString("HH:mm")</dd>

                            @if (c.Tipo == TipoCompromisso.Remoto)
                            {
                                <dt class="col-4 text-secondary fw-semibold">Link</dt>
                                <dd class="col-8 mb-0 text-break"><a href="@c.Link" target="_blank" rel="noopener noreferrer">@c.Link</a></dd>
                            }
                            else
                            {
                                <dt class="col-4 text-secondary fw-semibold">Local</dt>
                                <dd class="col-8 mb-0">@c.Local</dd>
                            }

                            <dt class="col-4 text-secondary fw-semibold">Contato</dt>
                            <dd class="col-8 mb-0">@(c.Contato?.Nome ?? "—")</dd>
                        </dl>

                        <div class="d-flex flex-wrap gap-2 mt-auto justify-content-end">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar" asp-route-id="@c.Id">Editar</a>
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir" asp-route-id="@c.Id">Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
