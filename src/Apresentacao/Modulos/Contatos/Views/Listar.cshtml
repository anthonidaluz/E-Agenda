@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Contatos";
}

@model List<ContatoDto>;

<a class="btn btn-primary rounded-pill px-4 mb-4" asp-action="Cadastrar"><i class="bi bi-plus-lg me-1"></i> Cadastrar Novo</a>

@if (!string.IsNullOrWhiteSpace(TempData["MensagemErro"]?.ToString()))
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @TempData["MensagemErro"]!.ToString()
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhum contato cadastrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (ContatoDto c in Model)
        {
            string iniciais = string.Concat(c.Nome
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(parte => char.ToUpper(parte[0])));

            <div class="col">
                <div class="card card-item h-100">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="card-icone rounded-circle bg-primary-subtle text-primary-emphasis">@iniciais</div>

                            <div class="flex-grow-1 text-truncate">
                                <h5 class="card-title fw-semibold mb-0 text-truncate">@c.Nome</h5>
                                <div class="small text-body-secondary text-truncate">
                                    @(c.Cargo ?? "Sem cargo")@(c.Empresa != null ? $" · {c.Empresa}" : "")
                                </div>
                            </div>

                            <span class="badge card-id rounded-pill align-self-start">#@c.Id.ToString("N")[..8]</span>
                        </div>

                        <dl class="row g-2 mb-4 small">
                            <dt class="col-4"><i class="bi bi-envelope"></i>Email</dt>
                            <dd class="col-8 mb-0 text-break"><a class="link-body-emphasis link-underline-opacity-0 link-underline-opacity-75-hover" href="mailto:@c.Email">@c.Email</a></dd>

                            <dt class="col-4"><i class="bi bi-telephone"></i>Telefone</dt>
                            <dd class="col-8 mb-0">@c.Telefone</dd>
                        </dl>

                        <div class="card-acoes d-flex flex-wrap gap-2 mt-auto pt-3 justify-content-end">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar" asp-route-id="@c.Id"><i class="bi bi-pencil me-1"></i>Editar</a>
                            <a class="btn btn-outline-danger btn-sm rounded-pill px-3" asp-action="Excluir" asp-route-id="@c.Id"><i class="bi bi-trash me-1"></i>Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
