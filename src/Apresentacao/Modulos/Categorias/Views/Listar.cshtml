@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Categorias";
}

@model List<CategoriaDto>;

<a class="btn btn-primary rounded-pill px-4 mb-4" asp-action="Cadastrar"><i class="bi bi-plus-lg me-1"></i> Cadastrar Nova</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhuma categoria cadastrada.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (CategoriaDto c in Model)
        {
            <div class="col">
                <div class="card card-item acento-secondary h-100">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="card-icone bg-secondary-subtle text-secondary-emphasis">
                                <i class="bi bi-tag"></i>
                            </div>

                            <h5 class="card-title fw-semibold mb-0 flex-grow-1 text-truncate">@c.Titulo</h5>

                            <span class="badge card-id rounded-pill">#@c.Id.ToString("N")[..8]</span>
                        </div>

                        <div class="card-acoes d-flex flex-wrap gap-2 mt-auto pt-3 justify-content-end">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar" asp-route-id="@c.Id"><i class="bi bi-pencil me-1"></i>Editar</a>
                            <a class="btn btn-outline-danger btn-sm rounded-pill px-3" asp-action="Excluir" asp-route-id="@c.Id"><i class="bi bi-trash me-1"></i>Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
