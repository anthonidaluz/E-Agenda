@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Despesa";
}

@model ExcluirDespesaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir" asp-route-id="@Model.Id" method="post">

    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        Deseja realmente excluir esta despesa?
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label fw-semibold text-primary text-uppercase small">Descrição</label>
        <input asp-for="Descricao" type="text" class="form-control" readonly>
    </div>

    <div class="mb-3">
        <label asp-for="DataOcorrencia" class="form-label fw-semibold text-primary text-uppercase small">Data de Ocorrência</label>
        <input asp-for="DataOcorrencia" type="date" class="form-control" readonly>
    </div>

    <div class="mb-3">
        <label asp-for="FormaPagamento" class="form-label fw-semibold text-primary text-uppercase small">Forma de Pagamento</label>
        <input asp-for="FormaPagamento" type="text" class="form-control" readonly>
    </div>

    <div class="mb-3">
        <label asp-for="Valor" class="form-label fw-semibold text-primary text-uppercase small">Valor</label>
        <input asp-for="Valor" type="number" step="0.01" class="form-control" readonly>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-danger rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
